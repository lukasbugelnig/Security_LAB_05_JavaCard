<?xml version="1.0" encoding="UTF-8"?>

<Macro xmlns="http://www.gi-de.com/offcard/gptasks/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gi-de.com/offcard/gptasks/1.0 TaskFile.xsd">
 <Tasks>
  <!-- W01.4 j) Testlauf 4: Overflow und Underflow
       Voraussetzung : Purse_03_Wallet ausgefuehrt (Guthaben = 8,10 EUR)
       Nachbedingung : Guthaben unveraendert 8,10 EUR (beide Operationen abgelehnt) -->

  <SelectAppletTask Name="Select Purse" Type="Applet">
   <AppletInstanceAid>31 32 33 34 32 36</AppletInstanceAid>
  </SelectAppletTask>

  <!-- Ausgangszustand bestaetigen -->
  <SendApduTask Name="Balance at start = 8.10 EUR">
   <Command>00 50 00 00 03</Command>
   <Answer>
    <Data>00 08 0A</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <!-- Overflow: Credit 9999,00 EUR -> 9999,00 + 8,10 = 10007,10 EUR > 9999,99 EUR -->
  <SendApduTask Name="Verify PIN2 2222">
   <Command>00 20 00 02 04 32 32 32 32</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <SendApduTask Name="Credit 9999.00 EUR overflow (expect 6A 84)">
   <Command>00 30 00 00 03 27 0F 00</Command>
   <Answer>
    <Sw>6A 84</Sw>
   </Answer>
  </SendApduTask>

  <SendApduTask Name="Balance unchanged after overflow = 8.10 EUR">
   <Command>00 50 00 00 03</Command>
   <Answer>
    <Data>00 08 0A</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <!-- Age18 erneut pruefen (bei Applet-Selektion zurueckgesetzt) -->
  <SendApduTask Name="Verify PIN1 1111 (for Age18)">
   <Command>00 20 00 01 04 31 31 31 31</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <SendApduTask Name="Age18 on 22.05.2026 (expect true)">
   <Command>00 18 00 00 08 32 32 30 35 32 30 32 36 01</Command>
   <Answer>
    <Data>01</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <!-- Underflow: Debit 100,00 EUR -> 8,10 - 100,00 = -91,90 EUR -->
  <SendApduTask Name="Verify PIN3 3333">
   <Command>00 20 00 03 04 33 33 33 33</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <SendApduTask Name="Debit 100.00 EUR underflow (expect 6A 81)">
   <Command>00 40 00 00 03 00 64 00</Command>
   <Answer>
    <Sw>6A 81</Sw>
   </Answer>
  </SendApduTask>

  <SendApduTask Name="Balance unchanged after underflow = 8.10 EUR">
   <Command>00 50 00 00 03</Command>
   <Answer>
    <Data>00 08 0A</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

 </Tasks>
</Macro>

<?xml version="1.0" encoding="UTF-8"?>

<Macro xmlns="http://www.gi-de.com/offcard/gptasks/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gi-de.com/offcard/gptasks/1.0 TaskFile.xsd">
 <Tasks>
  <!-- Kompletttest fuer W01.4 ohne optionale Aufgaben W01.4i und W01.5. -->

  <SelectAppletTask Name="Select Purse" Type="Applet">
   <AppletInstanceAid>31 32 33 34 32 36</AppletInstanceAid>
  </SelectAppletTask>

  <!-- PIN-Management: P2 waehlt PIN1/PIN2/PIN3. Default ist jeweils ASCII '0000'. -->
  <SendApduTask Name="Status initial">
   <Command>00 F2 00 00 09</Command>
   <Answer>
    <Data>00 00 00 03 03 03 0A 00 00</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Read without verified PIN (expect 69 82)">
   <Command>00 B6 00 00 50</Command>
   <Answer>
    <Sw>69 82</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify wrong PIN1 1234 (expect 63 C2)">
   <Command>00 20 00 01 04 31 32 33 34</Command>
   <Answer>
    <Sw>63 C2</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify default PIN1 0000">
   <Command>00 20 00 01 04 30 30 30 30</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Change PIN2 before PIN1 (expect 69 85)">
   <Command>00 24 00 02 04 32 32 32 32</Command>
   <Answer>
    <Sw>69 85</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Change PIN1 to 1111">
   <Command>00 24 00 01 04 31 31 31 31</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Change PIN1 again (expect 69 85)">
   <Command>00 24 00 01 04 39 39 39 39</Command>
   <Answer>
    <Sw>69 85</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify new PIN1 1111">
   <Command>00 20 00 01 04 31 31 31 31</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify default PIN2 0000">
   <Command>00 20 00 02 04 30 30 30 30</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Change PIN2 to 2222">
   <Command>00 24 00 02 04 32 32 32 32</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify default PIN3 0000">
   <Command>00 20 00 03 04 30 30 30 30</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Change PIN3 to 3333">
   <Command>00 24 00 03 04 33 33 33 33</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Status after all PIN changes">
   <Command>00 F2 00 00 09</Command>
   <Answer>
    <Data>01 01 01 03 03 03 0A 00 00</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <!-- Benutzerdaten: PIN1 darf schreiben, PIN1 oder PIN2 darf lesen. -->
  <SendApduTask Name="Modify user data John Doe 01.01.2000">
   <Command>00 D6 00 00 12 4A 6F 68 6E FF 44 6F 65 FF 30 31 30 31 32 30 30 30 FF</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Read user data with PIN1">
   <Command>00 B6 00 00 12</Command>
   <Answer>
    <Data>4A 6F 68 6E FF 44 6F 65 FF 30 31 30 31 32 30 30 30 FF</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Modify overlong first name (expect 6A 80)">
   <Command>00 D6 00 00 2D 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 FF 44 6F 65 FF 30 31 30 31 32 30 30 30 FF</Command>
   <Answer>
    <Sw>6A 80</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Read unchanged user data">
   <Command>00 B6 00 00 12</Command>
   <Answer>
    <Data>4A 6F 68 6E FF 44 6F 65 FF 30 31 30 31 32 30 30 30 FF</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <!-- Age18: Debit ist vor erfolgreicher Age18-Pruefung gesperrt. -->
  <SendApduTask Name="Verify PIN3 before age check">
   <Command>00 20 00 03 04 33 33 33 33</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Debit without Age18 (expect 69 85)">
   <Command>00 40 00 00 03 00 01 00</Command>
   <Answer>
    <Sw>69 85</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify PIN1 for Age18">
   <Command>00 20 00 01 04 31 31 31 31</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <!-- Age18: heutiges Datum muss als DDMMYYYY uebergeben werden. -->
  <SendApduTask Name="Age18 on 22.05.2026 (expect true)">
   <Command>00 18 00 00 08 32 32 30 35 32 30 32 36 01</Command>
   <Answer>
    <Data>01</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <!-- Geldboerse: PIN2 laedt, PIN3 bucht ab, Balance ist ohne PIN lesbar. -->
  <SendApduTask Name="Verify new PIN2 2222">
   <Command>00 20 00 02 04 32 32 32 32</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Balance initial 0.00 EUR">
   <Command>00 50 00 00 03</Command>
   <Answer>
    <Data>00 00 00</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Credit 12.34 EUR">
   <Command>00 30 00 00 03 00 0C 22</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Balance after credit 12.34 EUR">
   <Command>00 50 00 00 03</Command>
   <Answer>
    <Data>00 0C 22</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify new PIN3 3333">
   <Command>00 20 00 03 04 33 33 33 33</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Debit 5.04 EUR">
   <Command>00 40 00 00 03 00 05 04</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Balance after debit 7.30 EUR">
   <Command>00 50 00 00 03</Command>
   <Answer>
    <Data>00 07 1E</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Credit 0.80 EUR carry test">
   <Command>00 30 00 00 03 00 00 50</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Balance after carry 8.10 EUR">
   <Command>00 50 00 00 03</Command>
   <Answer>
    <Data>00 08 0A</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Credit overflow 9999.00 EUR (expect 6A 84)">
   <Command>00 30 00 00 03 27 0F 00</Command>
   <Answer>
    <Sw>6A 84</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Debit underflow 100.00 EUR (expect 6A 81)">
   <Command>00 40 00 00 03 00 64 00</Command>
   <Answer>
    <Sw>6A 81</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Balance unchanged after rejected commands">
   <Command>00 50 00 00 03</Command>
   <Answer>
    <Data>00 08 0A</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <!-- Logbuch: letzte Transaktionen, FIFO-Reihenfolge, PIN3-geschuetzt. -->
  <SendApduTask Name="Read log">
   <Command>00 76 00 00 0C</Command>
   <Answer>
    <Data>01 00 0C 22 02 00 05 04 01 00 00 50</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

  <!-- Unlock: erst nach drei falschen PIN3-Versuchen erlaubt, PUK ist ASCII '00000000'. -->
  <SendApduTask Name="Verify wrong PIN3 0001 (expect 63 C2)">
   <Command>00 20 00 03 04 30 30 30 31</Command>
   <Answer>
    <Sw>63 C2</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify wrong PIN3 0001 again (expect 63 C1)">
   <Command>00 20 00 03 04 30 30 30 31</Command>
   <Answer>
    <Sw>63 C1</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify wrong PIN3 0001 third time (expect 63 C0)">
   <Command>00 20 00 03 04 30 30 30 31</Command>
   <Answer>
    <Sw>63 C0</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Unlock PIN3 with PUK and set PIN3 to 4444">
   <Command>00 78 00 00 0C 30 30 30 30 30 30 30 30 34 34 34 34</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Verify unlocked PIN3 4444">
   <Command>00 20 00 03 04 34 34 34 34</Command>
   <Answer>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>
  <SendApduTask Name="Final status">
   <Command>00 F2 00 00 09</Command>
   <Answer>
    <Data>01 01 01 03 03 03 0A 01 00</Data>
    <Sw>90 00</Sw>
   </Answer>
  </SendApduTask>

 </Tasks>
</Macro>
